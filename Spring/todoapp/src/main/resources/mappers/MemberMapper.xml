<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- namespace에 현재 연결할 인터페이스의 패키지명부터 인터페이스명까지 전체를 작성-->
<mapper namespace="org.zerock.todoapp.member.mapper.MemberMapper">
    <!-- id에 인터페이스의 추상메서드와 같은 이름을 적어야 연동이됨-->
    <!-- resultType : 실행결과의 타입을 설정-->
    <select id="loginMember" resultType="org.zerock.todoapp.member.vo.MemberVO">
        SELECT * FROM tbl_member WHERE id=#{id} AND pw=#{pw}
    </select>
    <insert id="insertMember">
        INSERT INTO tbl_member(id,pw,email1,email2)
        VALUES (#{id}, #{pw}, #{email1}, #{email2});
    </insert>
    <delete id="deleteMember">
        DELETE FROM tbl_member WHERE id=#{id} AND pw=#{pw}
    </delete>

</mapper>